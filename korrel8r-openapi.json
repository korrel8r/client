  "info": {
    "contact": {
      "name": "Project Korrel8r",
      "url": "https://github.com/korrel8r/korrel8r"
    },
    "description": "Korrel8r correlates observability signals and resources in a Kubernetes cluster. It connects data from different domains (logs, metrics, alerts, traces, Kubernetes resources) by following correlation rules to build a graph of related objects.\nKorrel8r creates a separate session for each user with a unique HTTP Authorization header. Configuration changes, console state, and store connections are isolated per session. Requests without an Authorization header share a single default session.\n",
    "license": {
      "name": "Apache 2.0",
      "url": "https://github.com/korrel8r/korrel8r/blob/main/LICENSE"
    },
    "title": "Korrel8r REST API",
    "version": "v1alpha1",
    "x-korrel8r-version": "0.10.0"
  },
  "openapi": "3.0.1",
  "paths": {
    "/config": {
      "put": {
        "description": "Modify selected configuration settings (e.g. log verbosity) on a running service.\n",
        "operationId": "SetConfig",
        "parameters": [
          {
            "description": "Verbose level for logging.",
            "in": "query",
            "name": "verbose",
            "schema": {
              "maximum": 10,
              "minimum": 0,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Change configuration settings at runtime.",
        "tags": [
          "configure"
        ]
      }
    },
    "/console": {
      "put": {
        "description": "Store console state so an agent can read it via MCP tool get_console. The MCP client must have the same session (Authorization header) as the REST client.\n",
        "operationId": "SetConsole",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Console"
              }
            }
          },
          "description": "Parameters for the updated console display.",
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "Console display updated successfully"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "invalid parameters"
          }
        },
        "summary": "Make console state available to an agent.",
        "tags": [
          "console"
        ],
        "x-codegen-request-body-name": "request"
      }
    },
    "/console/events": {
      "get": {
        "description": "Updates are triggered by update requests from MCP tool show_in_console. The MCP client must have the same session (Authorization header) as the REST client.\n",
        "operationId": "ConsoleEvents",
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/Console"
                }
              }
            },
            "description": "SSE stream where each event's data field contains a JSON-encoded Console object.\n"
          }
        },
        "summary": "SSE event stream of console display updates from an agent.",
        "tags": [
          "console"
        ]
      }
    },
    "/domain/{domain}/classes": {
      "get": {
        "description": "Returns a list of class names for the specified domain.\n",
        "operationId": "ListDomainClasses",
        "parameters": [
          {
            "description": "Name of the domain to list classes for",
            "example": "k8s",
            "in": "path",
            "name": "domain",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "example": [
                    "Pod",
                    "Service",
                    "Deployment"
                  ],
                  "items": {
                    "description": "Class name (without domain prefix)",
                    "type": "string"
                  },
                  "type": "array",
                  "x-go-type-skip-optional-pointer": true
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "invalid parameters"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "domain not found"
          }
        },
        "summary": "Get the list of classes for a domain.",
        "tags": [
          "query"
        ]
      }
    },
    "/domains": {
      "get": {
        "description": "Returns a list of Korrel8r domains and the stores configured for each domain.\n",
        "operationId": "ListDomains",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Domain"
                  },
                  "type": "array",
                  "x-go-type-skip-optional-pointer": true
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "invalid parameters"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "result not found"
          }
        },
        "summary": "Get the list of correlation domains.",
        "tags": [
          "query"
        ]
      }
    },
    "/graphs/goals": {
      "post": {
        "description": "Specify a set of start objects, as queries or serialized objects, and a goal class. Returns a graph containing all paths leading from a start object to a goal object.\n",
        "operationId": "GraphGoals",
        "parameters": [
          {
            "$ref": "#/components/parameters/GraphOptions"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Goals"
              }
            }
          },
          "description": "Search from start to goal classes.",
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Graph"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "invalid parameters"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "result not found"
          }
        },
        "summary": "Create a correlation graph from start objects to goal queries.",
        "tags": [
          "correlate"
        ],
        "x-codegen-request-body-name": "request"
      }
    },
    "/graphs/neighbors": {
      "post": {
        "description": "Specify a set of start objects, as queries or serialized objects, and a depth for the neighborhood search. Returns a graph of all paths with depth or less edges leading from start objects.\n",
